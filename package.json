{
  "name": "coffee-with-antonio",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run build -w apps/api && concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "start": "npm run start -w apps/api",
    "test": "npm run test -w apps/api",
    "db:start": "node scripts/database.mjs",
    "seed": "node scripts/seed.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
