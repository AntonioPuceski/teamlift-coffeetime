DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffeetime
PORT=3001
# Optional AI booking confirmation. Keep the real key in .env or the host's secret store.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional Google Calendar FreeBusy integration (OAuth refresh token; see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
